{
  "name": "@gykh/caesar-cipher",
  "version": "3.1.2",
  "description": "⚡ Fast, zero-dependency Caesar cipher in Node.js supporting Strings, Buffers, Streams, ROT13, & Cracking.",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cipher.js",
    "index.js",
    "index.mjs",
    "index.d.ts",
    "validate.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.3.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-your-knowledge-here/caesar-cipher.git"
  },
  "keywords": [
    "caesar",
    "caesar-cipher",
    "caesar-shift",
    "rot13",
    "cipher",
    "cryptography",
    "encrypt",
    "decrypt",
    "encryption",
    "decryption",
    "streams",
    "typescript",
    "zero-dependencies",
    "playground",
    "rot13-decoder"
  ],
  "author": {
    "name": "Sylvester Das",
    "email": "sylvester.das@gmail.com",
    "url": "https://www.sylvesterdas.com"
  },
  "funding": "https://www.buymeacoffee.com/sylvester.das",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/get-your-knowledge-here/caesar-cipher/issues"
  },
